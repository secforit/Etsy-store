# =====================================================================================================
# Etsy agent team: environment for secforit-home.
#
#   cp .env.example .env && chmod 600 .env        (repository root; deploy/compose.sh refuses a readable .env)
#
# Read by docker compose (through ./deploy/compose.sh) and by every container that runs the core code
# (migrate, worker, desk). docs/RUNBOOK.md explains how to fill each value.
#
# Rules
#  - Never commit .env, never paste it anywhere. Keep a copy in your password manager (backups exclude it).
#  - Keys you do not use stay COMMENTED OUT. An empty value (KEY=) for an optional key is rejected at start-up.
#  - Values that contain `$` (the desk password hash) or JSON MUST be wrapped in single quotes.
#  - Any core secret can come from a Docker secret file instead: FOO_FILE=/run/secrets/foo fills FOO.
#  - DATABASE_URL, STORAGE_DIR, OLLAMA_BASE_URL, IMAGEGEN_BASE_URL and WORKER_HEARTBEAT_PATH are set by
#    deploy/docker-compose.yml for the containers; set them here only to run the CLI outside Docker.
# =====================================================================================================

# ----------------------------------------------------------------------------------------------- mode
# mock = deterministic offline mocks for Etsy, Printify, Marker, the LLM and image generation (nothing leaves
#        the server, nothing is published). Use it for the first start on the real stack.
# live = real APIs and the local GPU models. Switch only after the going-live checklist in the runbook.
MODE=mock
# fatal | error | warn | info | debug | trace   (logs never contain secrets or image bytes)
LOG_LEVEL=info

# ------------------------------------------------------------------------------- database (Postgres)
POSTGRES_USER=etsy
POSTGRES_DB=etsy
# REQUIRED. Hex only, it is embedded in DATABASE_URL:  openssl rand -hex 24
POSTGRES_PASSWORD=
# Only outside Docker (e.g. `npx tsx apps/worker/src/cli.ts status` on the host). Unset in mock mode = PGlite.
# DATABASE_URL=postgres://etsy:<password>@127.0.0.1:5432/etsy
# PGLITE_DIR=./data/pglite
# Blob storage root (designs, print files). The containers use /data/blobs on the `blobs` volume.
# STORAGE_DIR=./data/blobs

# ------------------------------------------------------------------- LLM (local Ollama on the RTX 3060)
# Every agent runs on the local model by default. Local calls cost $0 and do not count against the spend cap.
LLM_DEFAULT_PROVIDER=ollama
# Optional per-agent cloud override (needs the ANTHROPIC_* keys below), JSON in single quotes:
# LLM_ROUTES='{"compliance_guard":"anthropic"}'
# Decided models (Apache 2.0, fit 12 GB VRAM): do not substitute. See docs/MODELS.md.
OLLAMA_MODEL_LARGE=gemma4:12b
OLLAMA_MODEL_SMALL=gemma4:12b
OLLAMA_MODEL_VISION=gemma4:12b
# 16k context keeps gemma4:12b around 8 GB of VRAM.
OLLAMA_NUM_CTX=16384
# Ollama image tag used by compose. After the first good run, pin it to the version that worked
# (`./deploy/compose.sh exec ollama ollama --version`), so an upgrade never surprises you.
# OLLAMA_VERSION=latest
# OLLAMA_BASE_URL=http://ollama:11434

# ------------------------------------------------------------------ optional cloud LLM (Anthropic)
# Only when LLM_ROUTES or LLM_DEFAULT_PROVIDER uses "anthropic". Model ids are configuration, not code.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_LARGE=
# ANTHROPIC_MODEL_SMALL=
# USD per million tokens for each cloud model id. A model missing here is billed as $0 (the worker logs a
# warning at start-up) and the daily spend cap cannot see it, so fill it in whenever a route uses the cloud:
# LLM_PRICES_JSON='{"<anthropic-model-id>":{"inputPerMTokUsd":3,"outputPerMTokUsd":15}}'

# ------------------------------------------- image generation (local FLUX.2 [klein] 4B sidecar, GPU)
# local = apps/imagegen sidecar (FLUX.2 klein 4B + BiRefNet + Real-ESRGAN). recraft = optional cloud fallback.
IMAGEGEN_PROVIDER=local
# REQUIRED (also in mock mode, compose passes it to the sidecar). Shared secret worker -> sidecar:
#   openssl rand -hex 32
IMAGEGEN_TOKEN=
# Set to 1 once the weights are in the hf-models volume: the sidecar then never calls huggingface.co.
# IMAGEGEN_HF_OFFLINE=1
# Only if a model repository on Hugging Face asks you to accept terms (read-only token):
# HF_TOKEN=
# IMAGEGEN_BASE_URL=http://imagegen:8000
# Optional cloud fallback (IMAGEGEN_PROVIDER=recraft):
# RECRAFT_API_KEY=
# USD charged per Recraft image (generation + background removal); counted against the daily spend cap.
# RECRAFT_COST_PER_IMAGE_USD=0.08
# Reserved, not used by the current code:
# IDEOGRAM_API_KEY=

# ----------------------------------------------------------------------------------------- Etsy (live)
# Etsy app keystring and shared secret (https://www.etsy.com/developers/your-apps).
# ETSY_API_KEY=
# ETSY_SHARED_SECRET=
# Numeric shop id.
# ETSY_SHOP_ID=
# OAuth 2.0 refresh token with scopes listings_r listings_w transactions_r (see the runbook). The worker rotates
# it and keeps the current one in the blobs volume (.secrets/); this value is only the starting point.
# ETSY_REFRESH_TOKEN=

# ------------------------------------------------------------------------------------- Printify (live)
# Personal access token (Printify > My profile > Connections) and the id of the shop connected to Etsy.
# PRINTIFY_API_TOKEN=
# PRINTIFY_SHOP_ID=

# ------------------------------------------------------------------- Marker API (USPTO trademarks, live)
# MARKER_API_USERNAME=
# MARKER_API_PASSWORD=

# ---------------------------------------------------------------------------- Pinterest (optional)
# Without a token the Pinterest trend source returns nothing (Etsy search + seasonal calendar still work).
# PINTEREST_ACCESS_TOKEN=

# ---------------------------------------------------------------------------------------- approval desk
# REQUIRED for the desk. Make the hash with:
#   ./deploy/compose.sh run --rm --no-deps worker hash-password
# and paste it IN SINGLE QUOTES (it contains `$`):
# DESK_PASSWORD_HASH='scrypt$131072$8$1$<salt>$<hash>'
# REQUIRED for the desk. At least 32 characters:  openssl rand -base64 48   (changing it signs you out)
# DESK_SESSION_SECRET=
# REQUIRED for the desk. The exact HTTPS origin you open over Tailscale (no trailing slash):
# DESK_ORIGIN=https://secforit-home.<your-tailnet>.ts.net

# ------------------------------------------------------------------------------------ worker settings
# USD per 1 EUR, used to price Printify variants (USD) from EUR listing prices. Config, not live FX: check monthly.
# EUR_TO_USD=1.1
# Sleep between polls when there is nothing to do.
# WORKER_POLL_INTERVAL_MS=5000
# UTC hour when the daily trend scan becomes due (4 = 06:00/07:00 in Bucharest).
# TREND_SCAN_HOUR_UTC=4
# Metrics are pulled hourly; the analyst (weekly report, retirements, follow-ups) runs at most this often.
# ANALYST_REPORT_INTERVAL_HOURS=24
# WORKER_HEARTBEAT_PATH=/tmp/worker-heartbeat
