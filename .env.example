# =====================================================================================================
# Etsy agent team: SHARED environment for secforit-home (migrate, worker, desk, compose settings).
#
#   cp .env.example .env && chmod 600 .env        (repository root)
#
# Secrets are split per container (least privilege); each file has its own template:
#   .env           this file: shared settings, database, Etsy, Printify (read by migrate, worker AND desk)
#   .env.worker    worker-only secrets: imagegen token, Marker, LLM routing and cloud keys, Recraft, Pinterest
#   .env.desk      desk-only secrets: DESK_PASSWORD_HASH, DESK_SESSION_SECRET, DESK_ORIGIN
#   .env.imagegen  HF_TOKEN for the one-shot model download (optional)
# deploy/compose.sh runs deploy/check-env.sh first: it refuses to start when a file is readable by others or
# a secret sits in the wrong file (for example IMAGEGEN_TOKEN or MARKER_API_PASSWORD here, which the desk reads).
# docs/RUNBOOK.md (section 4) explains how to fill each value.
#
# Rules
#  - Never commit these files, never paste them anywhere. Keep a copy in your password manager (backups exclude them).
#  - Keys you do not use stay COMMENTED OUT. An empty value (KEY=) for an optional key is rejected at start-up.
#  - Values that contain `$` (the desk password hash) or JSON MUST be wrapped in single quotes.
#  - Any core secret can come from a Docker secret file instead: FOO_FILE=/run/secrets/foo fills FOO.
#  - DATABASE_URL, STORAGE_DIR, OLLAMA_BASE_URL, IMAGEGEN_BASE_URL and WORKER_HEARTBEAT_PATH are set by
#    deploy/docker-compose.yml for the containers; set them here only to run the CLI outside Docker.
# =====================================================================================================

# ----------------------------------------------------------------------------------------------- mode
# mock = deterministic offline mocks for Etsy, Printify, Marker, the LLM and image generation (nothing leaves
#        the server, nothing is published). Use it for the first start on the real stack.
# live = real APIs and the local GPU models. Switch only after the going-live checklist in the runbook.
MODE=mock
# fatal | error | warn | info | debug | trace   (logs never contain secrets or image bytes)
LOG_LEVEL=info

# ------------------------------------------------------------------------------- database (Postgres)
POSTGRES_USER=etsy
POSTGRES_DB=etsy
# REQUIRED. Hex only, it is embedded in DATABASE_URL:  openssl rand -hex 24
POSTGRES_PASSWORD=
# Only outside Docker (e.g. `npx tsx apps/worker/src/cli.ts status` on the host). Unset in mock mode = PGlite.
# DATABASE_URL=postgres://etsy:<password>@127.0.0.1:5432/etsy
# PGLITE_DIR=./data/pglite
# Blob storage root (designs, print files). The containers use /data/blobs on the `blobs` volume.
# STORAGE_DIR=./data/blobs

# ----------------------------------------------------------------------------- containers (compose)
# Ollama image. The compose file pins a tested release by version AND digest; override only with another
# pinned reference (check-env.sh refuses one without @sha256:), e.g.
# OLLAMA_IMAGE=ollama/ollama:<version>@sha256:<digest>
# The imagegen sidecar is offline by default (weights come from the one-shot `imagegen-download`, section 6
# of the runbook); it has no internet access either way.
# IMAGEGEN_HF_OFFLINE=1
# Memory limits per service (defaults in deploy/docker-compose.yml):
# LIMIT_MEM_IMAGEGEN=28g
# LIMIT_MEM_OLLAMA=16g
# LIMIT_MEM_POSTGRES=2g
# LIMIT_MEM_WORKER=4g
# LIMIT_MEM_DESK=4g

# ----------------------------------------------------------------------------------------- Etsy (live)
# Used by the worker and by the desk (approving a draft activates it on Etsy).
# Etsy app keystring and shared secret (https://www.etsy.com/developers/your-apps).
# ETSY_API_KEY=
# ETSY_SHARED_SECRET=
# Numeric shop id.
# ETSY_SHOP_ID=
# OAuth 2.0 refresh token with scopes listings_r listings_w transactions_r (see the runbook). The worker rotates
# it and keeps the current one in the blobs volume (.secrets/); this value is only the starting point.
# ETSY_REFRESH_TOKEN=

# ------------------------------------------------------------------------------------- Printify (live)
# Used by the worker and by the desk (catalog costs). Personal access token (Printify > My profile >
# Connections) and the id of the shop connected to Etsy.
# PRINTIFY_API_TOKEN=
# PRINTIFY_SHOP_ID=

# ------------------------------------------------------------------------------------ worker settings
# USD per 1 EUR, used to price Printify variants (USD) from EUR listing prices. Config, not live FX: check monthly.
# EUR_TO_USD=1.1
# Sleep between polls when there is nothing to do.
# WORKER_POLL_INTERVAL_MS=5000
# UTC hour when the daily trend scan becomes due (4 = 06:00/07:00 in Bucharest).
# TREND_SCAN_HOUR_UTC=4
# Metrics are pulled hourly; the analyst (weekly report, retirements, follow-ups) runs at most this often.
# ANALYST_REPORT_INTERVAL_HOURS=24
# WORKER_HEARTBEAT_PATH=/tmp/worker-heartbeat
