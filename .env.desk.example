# =====================================================================================================
# Etsy agent team: DESK-ONLY environment (only the approval desk container reads this file).
#
#   cp .env.desk.example .env.desk && chmod 600 .env.desk        (repository root, next to .env)
#
# DESK_* keys only (check-env.sh refuses anything else here, and refuses DESK_* keys in any other file).
# =====================================================================================================

# REQUIRED. Make the hash with:
#   ./deploy/compose.sh run --rm --no-deps worker hash-password
# and paste it IN SINGLE QUOTES (it contains `$`):
# DESK_PASSWORD_HASH='scrypt$131072$8$1$<salt>$<hash>'
# REQUIRED. At least 32 characters:  openssl rand -base64 48   (changing it signs you out)
# DESK_SESSION_SECRET=
# REQUIRED. The exact HTTPS origin you open over Tailscale (no trailing slash):
# DESK_ORIGIN=https://secforit-home.<your-tailnet>.ts.net
