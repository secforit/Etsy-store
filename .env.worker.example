# =====================================================================================================
# Etsy agent team: WORKER-ONLY environment (secrets no other app container may hold).
#
#   cp .env.worker.example .env.worker && chmod 600 .env.worker        (repository root, next to .env)
#
# Read by the worker container (after .env) and by compose for interpolation: the imagegen sidecar gets
# IMAGEGEN_TOKEN from here. The desk and migrate never see this file. Same rules as .env (see .env.example).
# =====================================================================================================

# ------------------------------------------------------------------------------------------- LLM routing
# Where each agent's model runs:
#   ollama     local gemma4:12b on the RTX 3060 (default). $0, not counted against the spend cap.
#   nous       Nous Research inference API (Nous Portal, open models, cloud). Needs the NOUS_* keys below.
#   anthropic  Claude (cloud). Needs the ANTHROPIC_* keys below.
# Cloud calls are priced and count against the daily spend cap. All-cloud (no GPU on the server):
#   LLM_DEFAULT_PROVIDER=nous and IMAGEGEN_PROVIDER=fal; deploy/compose.sh then starts neither GPU service.
LLM_DEFAULT_PROVIDER=ollama
# Optional per-agent override, JSON in single quotes:
# LLM_ROUTES='{"compliance_guard":"nous"}'
# Decided models (Apache 2.0, fit 12 GB VRAM): do not substitute. See docs/MODELS.md.
OLLAMA_MODEL_LARGE=gemma4:12b
OLLAMA_MODEL_SMALL=gemma4:12b
OLLAMA_MODEL_VISION=gemma4:12b
# 16k context keeps gemma4:12b around 8 GB of VRAM.
OLLAMA_NUM_CTX=16384
# OLLAMA_BASE_URL=http://ollama:11434

# ------------------------------------------------------- cloud LLM: Nous Research (Nous Portal, open models)
# Only when LLM_ROUTES or LLM_DEFAULT_PROVIDER uses "nous". Key from portal.nousresearch.com. Model ids are the
# Portal's own (<vendor>/<model>, e.g. nousresearch/hermes-4-405b); run `worker check-cloud` to confirm they are in
# your catalog, see their prices, and list the image-capable ones. Prices come from the Portal catalog
# automatically (LLM_PRICES_JSON below overrides them).
# NOUS_API_KEY=
# NOUS_MODEL_LARGE=
# NOUS_MODEL_SMALL=
# Must accept images: needed when compliance_guard or qa_publisher run on nous (final look, QA mockup check).
# NOUS_MODEL_VISION=
# NOUS_BASE_URL=https://inference-api.nousresearch.com/v1

# ------------------------------------------------------------------ optional cloud LLM (Anthropic)
# Only when LLM_ROUTES or LLM_DEFAULT_PROVIDER uses "anthropic". Model ids are configuration, not code.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_LARGE=
# ANTHROPIC_MODEL_SMALL=
# USD per million tokens for each cloud model id. In live mode the worker REFUSES TO START when a routed cloud
# model has no price here (the daily spend cap could not count it); an unpriced call is never billed at $0.
# LLM_PRICES_JSON='{"<anthropic-model-id>":{"inputPerMTokUsd":3,"outputPerMTokUsd":15}}'

# ----------------------------------------------------------------------------------- image generation
#   local    apps/imagegen sidecar on the GPU: FLUX.2 klein 4B + BiRefNet + Real-ESRGAN (default, $0)
#   fal      the same three models on fal.ai (cloud): art, transparent backgrounds and print-size upscaling
#   recraft  Recraft (cloud) art; upscaled by the sidecar when IMAGEGEN_TOKEN is set, else sharp only
IMAGEGEN_PROVIDER=local
# Shared secret worker -> sidecar, REQUIRED whenever the sidecar runs (local, or recraft with the sidecar
# upscaler; also in mock mode). Comment it out for IMAGEGEN_PROVIDER=fal.
#   openssl rand -hex 32
IMAGEGEN_TOKEN=
# IMAGEGEN_BASE_URL=http://imagegen:8000
# IMAGEGEN_PROVIDER=fal: key from fal.ai/dashboard/keys.
# FAL_KEY=
# USD per call, counted against the daily spend cap. The defaults sit above fal's list prices (the cap trips
# early rather than late); set them to your fal prices for accurate cost-per-listing numbers.
# FAL_COST_PER_IMAGE_USD=0.02
# FAL_COST_PER_BACKGROUND_REMOVAL_USD=0.01
# FAL_COST_PER_UPSCALE_USD=0.02
# Optional cloud fallback (IMAGEGEN_PROVIDER=recraft):
# RECRAFT_API_KEY=
# USD charged per Recraft image (generation + background removal); counted against the daily spend cap.
# RECRAFT_COST_PER_IMAGE_USD=0.08
# Reserved, not used by the current code:
# IDEOGRAM_API_KEY=

# ------------------------------------------------------------------- Marker API (USPTO trademarks, live)
# MARKER_API_USERNAME=
# MARKER_API_PASSWORD=

# ---------------------------------------------------------------------------- Pinterest (optional)
# Without a token the Pinterest trend source returns nothing (Etsy search + seasonal calendar still work).
# PINTEREST_ACCESS_TOKEN=
